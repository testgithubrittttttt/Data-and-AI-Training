import json
import logging

# Set up logging
logging.basicConfig(filename='app.log', level=logging.INFO, format='%(levelname)s - %(message)s')

try:
    with open('students.json', 'r') as file:
        students = json.load(file)
        logging.info("File read successful")
except FileNotFoundError:
    logging.error("students.json file not found")
    students = []

# 1. Print all student names
for student in students:
    print(student['name'])

# 2. Add new student
new_student = {"name": "Arjun", "age": 20, "course": "Data Science", "marks": 78}
students.append(new_student)
logging.info("Student added")

# 3. Save updated list
with open('students.json', 'w') as file:
    json.dump(students, file, indent=4)
    logging.info("File saved")
