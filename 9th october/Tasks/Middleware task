#create a  middleware that calculates how long each request takes to exceute and returns it in a response header

import time
from fastapi import FastAPI, Request

app = FastAPI()

@app.middleware("http")
async def add_process_time_header(request: Request, call_next):
    start_time = time.time()  # Start time before processing
    response = await call_next(request)  # Process the request
    process_time = time.time() - start_time  # Time taken
    response.headers["X-Process-Time"] = str(round(process_time, 4))  # Add header
    return response

@app.get("/")
async def read_root():
    return {"message": "Hello, FastAPI!"}
